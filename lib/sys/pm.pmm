//  Array types
type array(e,d:dimension_number) is marray(e,d),darray(e,d)
type varray(e,d:dimension_number) is mvarray(e,d),dvarray(e,d)
type farray(e,d:dimension_number) is mfarray(e,d),dfarray(e,d)

type marray(e,d:dimension_number) is mvarray(e,d),mfarray(e,d)
type mvarray(e,d:dimension_number) is e^var extent(d)
type mfarray(e,d:dimension_number) is e^let extent(d)

type index is any_int,tuple(any_int)
type slice_dim is range(any_int),seq(any_int),range_above(any_int), range_below(any_int),seq_above(any_int),seq_below(any_int), seq_step(any_int),null
type slice is slice_dim,tuple(slice_dim)
type subs_dim is slice_dim,any_int
type subs is index,slice,subs_dim,tuple(subs_dim)

