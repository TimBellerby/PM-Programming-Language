PM__intrinsic PM__move(any)->(*): "link_var"

proc PM__localise%(x)=x

//PM__intrinsic PM__localise%(x:any)->(*): "clone_var" 
PM__intrinsic same_type(x:any,y:any)->(*) : "same_type_fold"
PM__intrinsic same_type(x:any,y:literal)->(*) : "same_type_fold"
PM__intrinsic same_type(x:literal,y:any)->(*) : "same_type_fold"
PM__intrinsic same_type(x:literal,y:literal)->(*) : "same_type_fold"
PM__intrinsic same_rec(x:any,y:any)->(*) : "same_rec_fold"

proc ==(x:a_rec,y:a_rec)->() {
  test   same_rec(x,y) else "Cannot apply ""=="" to different records"
  var ok=true
  _eq(x,y,&ok)
  return ok
}
proc /=(x:a_rec,y:a_rec)->() {
  test   same_rec(x,y) else "Cannot apply ""/="" to different records"
  var ok=true
  _eq(x,y,&ok)
  return not ok
}
proc _eq(x,y,&ok) <<inline>> {
    PM__each_index i in num_elements(x) {
        ok=ok and x^{i}==y^{i}
    }
}


proc PM__valref(x)=x
proc PM__check_alias(...){}
 
proc next_enum(x:int)=x+convert(1,x)
proc next_enum(x:int,y:int)=x+convert(y,x)

PM__intrinsic<<needs_type>> .element_at_index(&x:any,y:fix(int))->(*):"elem"
PM__intrinsic<<needs_type>> _element_at_index(x:any,y:fix(int))->(*):"elem"


//  Type values
