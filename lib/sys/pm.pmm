proc array(x,d:extent(2))=_array(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi)
proc array(x,d:extent(3))=_array(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi,d.3._lo,d.3._hi)
proc array(x,d:extent(4))=_array(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi,d.3._lo,d.3._hi,d.4._lo,d.4._hi)
proc array(x,d:extent(5))=_array(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi,d.3._lo,d.3._hi,d.4._lo,d.4._hi,d.5._lo,d.5._hi)
proc array(x,d:extent(6))=_array(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi,d.3._lo,d.3._hi,d.4._lo,d.4._hi,d.5._lo,d.5._hi,d.6._lo,d.6._hi)
