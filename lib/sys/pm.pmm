proc map_apply_dims(q:proc,p:proc,x:tuple2d)=p.(q.(x.1),q.(x.2))
proc map_apply_dims(q:proc,p:proc,x:tuple3d)=p.(q.(x.1),q.(x.2),q.(x.3))
proc map_apply_dims(q:proc,p:proc,x:tuple4d)=p.(q.(x.1),q.(x.2),q.(x.3),q.(x.4))
