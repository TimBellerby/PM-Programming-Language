proc map_apply_dims(q:proc,p:proc,x:tuple4d,y:tuple4d,z:tuple4d)=p.(q.(x.1,y.1,z.1),q.(x.2,y.2,z.2),q.(x.3,y.3,z.3),q.(x.4,y.4,z.4))
