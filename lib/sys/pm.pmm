proc rank(x:tuple1d)=1
proc rank(x:tuple2d)=2
proc rank(x:tuple3d)=3
proc rank(x:tuple4d)=4
proc rank(x:tuple5d)=5
proc rank(x:tuple6d)=6
proc rank(x:tuple7d)=7

proc reduce_dims(p:proc,x:tuple1d)=x.1
proc reduce_dims(p:proc,x:tuple2d)=p.(x.2,x.1)
