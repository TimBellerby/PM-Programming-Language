proc #(x:any^extent(1))=shape([_lbound1(x).._ubound1(x)])
proc #(x:any^extent(2))=shape([_lbound1(x).._ubound1(x),_lbound2(x).._ubound2(x)])
proc #(x:any^extent(3))=shape([_lbound1(x).._ubound1(x),_lbound2(x).._ubound2(x),_lbound3(x).._ubound3(x)])
proc #(x:any^extent(4))=shape([_lbound1(x).._ubound1(x),_lbound2(x).._ubound2(x),_lbound3(x).._ubound3(x),_lbound4(x).._ubound4(x)])
proc #(x:any^extent(5))=shape([_lbound1(x).._ubound1(x),_lbound2(x).._ubound2(x),_lbound3(x).._ubound3(x),_lbound4(x).._ubound4(x),_lbound5(x).._ubound5(x)])
proc #(x:any^extent(6))=shape([_lbound1(x).._ubound1(x),_lbound2(x).._ubound2(x),_lbound3(x).._ubound3(x),_lbound4(x).._ubound4(x),_lbound5(x).._ubound5(x),_lbound6(x).._ubound6(x)])
