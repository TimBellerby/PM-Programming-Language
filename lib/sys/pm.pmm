type shape(n:dimension_number,d) is rec{_extent:extent(n),_distr:d}
proc shape(x,d)=rec shape{_extent=x,_distr=d}
proc shape(x)=shape(x,null)
proc string(x:shape)="shape("++x._extent++","++x._distr++")"
proc size(x:shape)=size(x._extent)
proc #(x:shape)=x._extent

