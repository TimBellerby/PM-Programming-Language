proc is(x,t)=t inc typeof(x)
proc isnot(x,t)=not(x is t)

PM__intrinsic as(x:any,t:<any>)->(*): "setref"
proc as(x,t:<any> when x isnot t)=PM__cast(x,t)
//proc as(x,t)=convert(x,t)
proc convert(x,t:a_poly|proc)=PM__cast(x,typeof(t))
proc convert(x,t)=x
PM__intrinsic<<needs_type>> inc(x:<any>,y:<any>)->(*) : "type_include_fold"
proc ==(x:<any>,y:<any>)=x inc y and y inc x
