proc map_dims(p:proc,x:tuple1d,y:tuple1d)=[u1],[v1]where u1,v1=p.(x.1,y.1)
proc map_dims(p:proc,x:tuple2d,y:tuple2d)=[u1,u2],[v1,v2]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2)
proc map_dims(p:proc,x:tuple3d,y:tuple3d)=[u1,u2,u3],[v1,v2,v3]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2),u3,v3=p.(x.3,y.3)
proc map_dims(p:proc,x:tuple4d,y:tuple4d)=[u1,u2,u3,u4],[v1,v2,v3,v4]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2),u3,v3=p.(x.3,y.3),u4,v4=p.(x.4,y.4)
proc map_dims(p:proc,x:tuple5d,y:tuple5d)=[u1,u2,u3,u4,u5],[v1,v2,v3,v4,v5]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2),u3,v3=p.(x.3,y.3),u4,v4=p.(x.4,y.4),u5,v5=p.(x.5,y.5)
proc map_dims(p:proc,x:tuple6d,y:tuple6d)=[u1,u2,u3,u4,u5,u6],[v1,v2,v3,v4,v5,v6]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2),u3,v3=p.(x.3,y.3),u4,v4=p.(x.4,y.4),u5,v5=p.(x.5,y.5),u6,v6=p.(x.6,y.6)
proc map_dims(p:proc,x:tuple7d,y:tuple7d)=[u1,u2,u3,u4,u5,u6,u7],[v1,v2,v3,v4,v5,v6,v7]where u1,v1=p.(x.1,y.1),u2,v2=p.(x.2,y.2),u3,v3=p.(x.3,y.3),u4,v4=p.(x.4,y.4),u5,v5=p.(x.5,y.5),u6,v6=p.(x.6,y.6),u7,v7=p.(x.7,y.7)

