proc map_reduce_dims(q:proc,p:proc,x:tuple1d)=q.(x.1)
proc map_reduce_dims(q:proc,p:proc,x:tuple2d)=p.(q.(x.2),q.(x.1))
proc map_reduce_dims(q:proc,p:proc,x:tuple3d)=p.(p.(q.(x.3),q.(x.2)),q.(x.1))
proc map_reduce_dims(q:proc,p:proc,x:tuple4d)=p.(p.(p.(q.(x.4),q.(x.3)),q.(x.2)),q.(x.1))
proc map_reduce_dims(q:proc,p:proc,x:tuple5d)=p.(p.(p.(p.(q.(x.5),q.(x.4)),q.(x.3)),q.(x.2)),q.(x.1))
