proc map_reduce_dims(q:proc,p:proc,x:tuple7d,y:tuple7d,z:tuple7d)=p.(p.(p.(p.(p.(p.(q.(x.7,y.7,z.7),q.(x.6,y.6,z.6)),q.(x.5,y.5,z.5)),q.(x.4,y.4,z.4)),q.(x.3,y.3,z.3)),q.(x.2,y.2,z.2)),q.(x.1,y.1,z.1))

proc apply_dims(p:proc,x:tuple1d)=p.(x.1)
proc apply_dims(p:proc,x:tuple2d)=p.(x.1,x.2)
proc apply_dims(p:proc,x:tuple3d)=p.(x.1,x.2,x.3)
