proc varray(x,d:extent(2))=_varray(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi)
proc varray(x,d:extent(3))=_varray(x,d,d.1._lo,d.1._hi,d.2._lo,d.2._hi,d.3._lo,d.3._hi)
