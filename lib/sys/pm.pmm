proc _point2list(t:tuple(int,1))=PM__list(t.1) 
proc _point2list(t:tuple(int,2))=PM__list(t.1,t.2) 
proc _point2list(t:tuple(int,3))=PM__list(t.1,t.2,t.3)
proc _point2list(t:tuple(int,4))=PM__list(t.1,t.2,t.3,t.4) 
