proc map_const_dims(p:proc,x:tuple2d,y)=[p.(x.1,y),p.(x.2,y)]
proc map_const_dims(p:proc,x:tuple3d,y)=[p.(x.1,y),p.(x.2,y),p.(x.3,y)]
