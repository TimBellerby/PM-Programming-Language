proc map_apply_dims(q:proc,p:proc,x:tuple6d,y:tuple6d)=p.(q.(x.1,y.1),q.(x.2,y.2),q.(x.3,y.3),q.(x.4,y.4),q.(x.5,y.5),q.(x.6,y.6))
proc map_apply_dims(q:proc,p:proc,x:tuple7d,y:tuple7d)=p.(q.(x.1,y.1),q.(x.2,y.2),q.(x.3,y.3),q.(x.4,y.4),q.(x.5,y.5),q.(x.6,y.6),q.(x.7,y.7))

proc map_apply_dims(q:proc,p:proc,x:tuple,y:tuple,z:tuple)=error_type() :compile_error("Number of dimensions does not match")
proc map_apply_dims(q:proc,p:proc,x:tuple1d,y:tuple1d,z:tuple1d)=p.(q.(x.1,y.1,z.1))
proc map_apply_dims(q:proc,p:proc,x:tuple2d,y:tuple2d,z:tuple2d)=p.(q.(x.1,y.1,z.1),q.(x.2,y.2,z.2))
