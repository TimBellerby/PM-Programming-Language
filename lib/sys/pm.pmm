proc map_apply_dims(q:proc,p:proc,x:tuple7d)=p.(q.(x.1),q.(x.2),q.(x.3),q.(x.4),q.(x.5),q.(x.6),q.(x.7))

proc map_apply_dims(q:proc,p:proc,x:tuple,y:tuple)=error_type():compile_error("Number of dimensions does not match")
proc map_apply_dims(q:proc,p:proc,x:tuple1d,y:tuple1d)=p.(q.(x.1,y.1))
proc map_apply_dims(q:proc,p:proc,x:tuple2d,y:tuple2d)=p.(q.(x.1,y.1),q.(x.2,y.2))
