proc map_reduce_dims(q:proc,p:proc,x:tuple2d,y:tuple2d)=p.(q.(x.2,y.2),q.(x.1,y.1))
proc map_reduce_dims(q:proc,p:proc,x:tuple3d,y:tuple3d)=p.(p.(q.(x.3,y.3),q.(x.2,y.2)),q.(x.1,y.1))
