PM__if_compiling
PM__intrinsic PM__assign_var(&x:any,y:any): "assign_move"
PM__else
PM__intrinsic PM__assign_var(&x:any,y:any): "init_const"
PM__endif
*/

PM__intrinsic PM__init_const(&a:PM__uninit,b:any): "init_const"

proc PM__init_const(&a:PM__uninit,b:any when b isnot PM__typeof(a))<<inline>>: PM__init_const(&a,c <<PM__uninit>>) where c=b as PM__typeof(a)

proc PM__init_const(&a,b):compile_error("Cannot initialise a constant value twice")

PM__intrinsic PM__init_const(&a:PM__uninit,b:literal): "init_const"

proc PM__init_const(&a:PM__uninit,b:literal when b isnot PM__typeof(a))<<inline>>: PM__init_const(&a,c <<PM__uninit>>) where c=b as PM__typeof(a)

proc PM__assign_op(&a:any,b:any,c:proc) {
    compile_error("Not a recognised assignment operator") 
}

PM__intrinsic _assign(&any,any): "assign"

proc PM__assign_ref(&a,&b,cp):PM__assign(&a,b)

proc PM__assign(&a:any,b:any) {
   _assign(&a,c) where c=convert(b,a)
}

proc PM__assign(&a:any^any,b:any,j:tuple(int)) {
    _set_array_element(&a,j,c) where c=convert(b,_get_array_element(a,j))
}

proc PM__assign(&a:a_rec,b:any,j:element_accessor) {
   PM__assign(&a^&{j},b)
}

proc PM__assign(&a,b:any,j,...) {
    PM__assign(&a^PM__lhs(j),...)
}

proc PM__assign(&a:any^any,b:any,j:tuple(int),...) {
    PM__assign(&a^_make_subref(j),b,...)
}

proc PM__assign(&a:a_rec,b:any,j:element_accessor,...) {
    PM__assign(&a^&{j},b,...)
}

/*
proc _assign(&a:any,b:any) {
    test "Cannot assign values"=>same_type(a,b)
    _assign_element(&a,b)
}
*/

proc _assign(&a:a_rec,b:a_rec) {
  test "Cannot assign different records"=>same_rec(a,b)
  PM__each_index i in num_elements(a) {
      PM__assign(&a^{i},b^{i} <<keep_literals>>)
  }
}

proc _assign(&a:a_rec,b:a_rec when _directly_assignable(a,b)) {
  _assign_element(&a,b)
}

proc _assign(&a:literal,b:literal) {
    test "Cannot assign values"=>same_type(a,b)
}

proc _assign(&a:fix,b:fix) {
    test "Cannot assign values"=>same_type(a,b)
}

PM__intrinsic _assign_element(&any,any): "assign"

PM__intrinsic PM__get_ref(x:PM__ref(any))->(*) : "get_rf"
proc PM__get_ref(x)=x
proc PM__get_ref%(x)=PM__get_ref(x)
proc PM__get_ref%(x,j)=PM__get_ref(x,j)
proc PM__get_ref(x,j)=element(x,j)
proc PM__get_ref(x,j,...)=PM__get_ref(PM__get_ref(x,j),...)
proc PM__get_ref%(x,j,...)=PM__get_ref(PM__get_ref(x,j),...)
proc PM__get_ref(x:a_rec,j:element_accessor)=x^{j}
proc PM__get_ref(x:any^any,j:tuple(int))=_get_array_element(x,j)
proc PM__get_ref(x:any,j:PM__list(proc,any)) {
    PM__set_dotdotdot(j^*{2})
    return PM__get_ref(x,j^*{1}.(x,... <<PM__ref>>))
}
proc PM__get_ref(x:any,j:PM__list(null,any))=j^*{2}
proc PM__get_ref(x:any,j:PM__list) {
    PM__set_dotdotdot(j)
    return PM__get_ref(x,...)
}
proc PM__get_ref(x:a_poly,j:PM__list(proc,any)) {
    PM__set_dotdotdot(j^*{2})
    let r...
    any x {r=PM__get_ref(x,j^*{1}.(x,... <<PM__ref>>))}
    return r
}

proc PM__lhs(x)=x
proc PM__lhs(x,j:element_accessor)=x^&{j}
proc PM__lhs(x,j,...)=PM__lhs(PM__lhs(x,j),...)
proc PM__lhs(x,j:tuple(int))=x^_make_subref(j)
proc PM__lhs(x:any,j:PM__list(proc,any)) {
    PM__set_dotdotdot(j^*{2})
    return PM__lhs(x,j^*{1}.(x,... <<PM__ref>>))
}
proc PM__lhs(x:any,j:PM__list(null,any))=j^*{2}
proc PM__lhs(x:any,j:PM__list) {
    PM__set_dotdotdot(j)
    return PM__lhs(x,...)
}

proc PM__subs(x)=[x]
proc PM__subs(x,...)=[x,...]
proc PM__subs(x:tuple)=x

